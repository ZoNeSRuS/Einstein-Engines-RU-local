<PanelContainer xmlns="https://spacestation14.io"
                StyleClasses="LowDivider">
    <BoxContainer Orientation="Vertical"
                  Margin="8"
                  SeparationOverride="4">
        <RichTextLabel Name="StageTitleLabel"
                       HorizontalExpand="True"
                       MaxWidth="420" />
        <Label Name="RewardLabel"
               StyleClasses="LabelSubText"
               FontColorOverride="#d7d7d7"
               ClipText="False" />
        <RichTextLabel Name="DescriptionLabel"
                       HorizontalExpand="True"
                       MaxWidth="420" />
        <RichTextLabel Name="StatusLabel"
                       HorizontalExpand="True"
                       MaxWidth="420" />
        <BoxContainer Name="ButtonsContainer"
                      Orientation="Horizontal"
                      HorizontalExpand="True"
                      SeparationOverride="6"
                      Visible="False">
            <Button Name="FailButton"
                    StyleClasses="ButtonDanger"
                    HorizontalExpand="True"
                    Text="{Loc 'department-reward-console-fail-button'}" />
            <Button Name="ConfirmButton"
                    StyleClasses="ButtonSuccess"
                    HorizontalExpand="True"
                    Text="{Loc 'department-reward-console-confirm-button'}" />
        </BoxContainer>
    </BoxContainer>
</PanelContainer>
