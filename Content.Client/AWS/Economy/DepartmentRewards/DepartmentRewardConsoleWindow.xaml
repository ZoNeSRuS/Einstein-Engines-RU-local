<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      Title="{Loc 'department-reward-console-title'}"
                      MinSize="760 420"
                      Resizable="True">
    <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True" Margin="8" SeparationOverride="8">
        <BoxContainer Orientation="Horizontal" HorizontalExpand="True" VerticalExpand="True" SeparationOverride="8">
            <!-- Summary column -->
            <PanelContainer StyleClasses="BackgroundDark" MinWidth="440" VerticalExpand="True" SizeFlagsStretchRatio="5">
                <BoxContainer Orientation="Vertical" Margin="8" SeparationOverride="8" HorizontalExpand="True" VerticalExpand="True">
                    <BoxContainer Orientation="Horizontal" SeparationOverride="4">
                        <Label Text="{Loc 'department-reward-console-department-label-inline'}" StyleClasses="LabelBold" />
                        <Label Name="DepartmentLabel" StyleClasses="LabelHeading" ClipText="False" />
                    </BoxContainer>

                    <PanelContainer StyleClasses="LowDivider" Margin="0 4" />

                    <ScrollContainer HorizontalExpand="True" VerticalExpand="True" HScrollEnabled="False" ReturnMeasure="True">
                        <BoxContainer Name="TasksContainer"
                                      Orientation="Vertical"
                                      HorizontalExpand="True"
                                      VerticalExpand="True"
                                      SeparationOverride="8" />
                    </ScrollContainer>
                    <!-- Hidden legacy buttons kept for generated references -->
                    <Button Name="FailButton" Visible="False" />
                    <Button Name="ConfirmButton" Visible="False" />
                </BoxContainer>
            </PanelContainer>

            <!-- Content column -->
            <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True" SeparationOverride="8" SizeFlagsStretchRatio="1.2">
                <PanelContainer StyleClasses="BackgroundDark" HorizontalExpand="True" MinHeight="80">
                    <BoxContainer Orientation="Vertical" Margin="8" HorizontalExpand="True" VerticalExpand="True" SeparationOverride="6">
                        <Label Text="{Loc 'department-reward-console-status-label'}" StyleClasses="LabelBold" />
                        <Label Name="StatusLabel" ClipText="False" FontColorOverride="#d7d7d7" />
                    </BoxContainer>
                </PanelContainer>

                <PanelContainer StyleClasses="BackgroundDark" HorizontalExpand="True" VerticalExpand="True" MinHeight="120">
                    <BoxContainer Orientation="Vertical" Margin="8" HorizontalExpand="True" VerticalExpand="True">
                        <Label Text="{Loc 'department-reward-console-history-label'}" StyleClasses="LabelBold" />
                        <PanelContainer StyleClasses="LowDivider" Margin="0 4" />
                        <ScrollContainer HorizontalExpand="True" VerticalExpand="True">
                            <BoxContainer Name="HistoryContainer" Orientation="Vertical" HorizontalExpand="True" SeparationOverride="4" />
                        </ScrollContainer>
                    </BoxContainer>
                </PanelContainer>
            </BoxContainer>
        </BoxContainer>

        <PanelContainer StyleClasses="LowDivider" Margin="0 4 0 0" />
        <BoxContainer Orientation="Horizontal" HorizontalExpand="True" SeparationOverride="6">
            <Label Text="{Loc 'department-reward-console-auth-label'}" StyleClasses="LabelBold" />
            <Label Name="AuthStatusLabel" ClipText="False" HorizontalExpand="True" />
            <Button Name="AuthEjectButton"
                    Access="Public"
                    Text="{Loc 'id-card-console-window-eject-button'}" />
        </BoxContainer>
    </BoxContainer>
</controls:FancyWindow>
